psych::alpha(like_items_insp, check.keys = TRUE)$total %>% select(raw_alpha, std.alpha) %>% print()
# ── Inter-composite correlation ────────────────────────────────────────────
cor.test(tl_dat$trust, tl_dat$likeability, use = "complete.obs") %>% tidy() %>% print()
library(lme4)
library(lmerTest)
# ── Trust null model ───────────────────────────────────────────────────────
M0_trust = lmer(
trust ~ 1 + (1 | responseid) + (1 | severity),
data = tl_dat,
REML = TRUE
)
summary(M0_trust)
# ICC: proportion of variance at each level
vc_trust = as.data.frame(VarCorr(M0_trust))
icc_participant_trust = vc_trust$vcov[vc_trust$grp == "responseid"] / sum(vc_trust$vcov)
icc_vignette_trust    = vc_trust$vcov[vc_trust$grp == "severity"]   / sum(vc_trust$vcov)
print(paste("Trust ICC (participant):", round(icc_participant_trust, 3)))
print(paste("Trust ICC (vignette):",    round(icc_vignette_trust, 3)))
# ── Likeability null model ─────────────────────────────────────────────────
M0_like = lmer(
likeability ~ 1 + (1 | responseid) + (1 | severity),
data = tl_dat,
REML = TRUE
)
summary(M0_like)
vc_like = as.data.frame(VarCorr(M0_like))
icc_participant_like = vc_like$vcov[vc_like$grp == "responseid"] / sum(vc_like$vcov)
icc_vignette_like    = vc_like$vcov[vc_like$grp == "severity"]   / sum(vc_like$vcov)
print(paste("Likeability ICC (participant):", round(icc_participant_like, 3)))
print(paste("Likeability ICC (vignette):",    round(icc_vignette_like, 3)))
# Model 1: Role only (H1a)
T1 = lmer(
trust ~ role_ec + (1 | responseid) + (1 | severity),
data = tl_dat, REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
# Model 2: Severity only
T2 = lmer(
trust ~ severity_num + (1 | responseid) + (1 | severity),
data = tl_dat, REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
# Model 3: Role + Severity (additive)
T3 = lmer(
trust ~ role_ec + severity_num + (1 | responseid) + (1 | severity),
data = tl_dat, REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
# Model 4: Role × Severity interaction (H1b)
T4 = lmer(
trust ~ role_ec * severity_num + (1 | responseid) + (1 | severity),
data = tl_dat, REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
# ── Model comparison ───────────────────────────────────────────────────────
anova(T1, T2, T3, T4)
# ── Summaries ─────────────────────────────────────────────────────────────
summary(T1)
summary(T3)
summary(T4)
library(emmeans)
emm_trust = emmeans(T4, ~ role_ec | severity_num,
at = list(severity_num = c(-1, 0, 1)))
# Recode for readable output
emm_trust_role = emmeans(T4, pairwise ~ role_ec | severity_num,
at = list(severity_num = c(-1, 0, 1)),
adjust = "bonferroni")
summary(emm_trust_role$contrasts)
# Effect sizes (Cohen's d)
eff_size(emm_trust, sigma = sigma(T4), edf = df.residual(T4))
# Model 1: Role only (H2a)
L1 = lmer(
likeability ~ role_ec + (1 | responseid) + (1 | severity),
data = tl_dat, REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
# Model 2: Severity only
L2 = lmer(
likeability ~ severity_num + (1 | responseid) + (1 | severity),
data = tl_dat, REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
# Model 3: Role + Severity (additive)
L3 = lmer(
likeability ~ role_ec + severity_num + (1 | responseid) + (1 | severity),
data = tl_dat, REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
# Model 4: Role × Severity interaction (H2b)
L4 = lmer(
likeability ~ role_ec * severity_num + (1 | responseid) + (1 | severity),
data = tl_dat, REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
# ── Model comparison ───────────────────────────────────────────────────────
anova(L1, L2, L3, L4)
summary(L1)
summary(L3)
summary(L4)
emm_like_role = emmeans(L4, pairwise ~ role_ec | severity_num,
at = list(severity_num = c(-1, 0, 1)),
adjust = "bonferroni")
summary(emm_like_role$contrasts)
eff_size(emmeans(L4, ~ role_ec | severity_num,
at = list(severity_num = c(-1, 0, 1))),
sigma = sigma(L4), edf = df.residual(L4))
emm_like_df = as.data.frame(emmeans(L4, ~ role_ec * severity_num,
at = list(severity_num = c(-1, 0, 1)))) %>%
mutate(
Role     = if_else(role_ec == 1, "Inspector", "Investigator"),
Severity = factor(severity_num, levels = c(-1, 0, 1),
labels = c("Minor", "Moderate", "Major"))
)
ggplot(emm_like_df, aes(x = Severity, y = emmean, color = Role, group = Role)) +
geom_line(linewidth = 1) +
geom_point(size = 3) +
geom_errorbar(aes(ymin = lower.CL, ymax = upper.CL), width = 0.15) +
scale_color_manual(values = c("Inspector" = "#2196F3", "Investigator" = "#E53935")) +
labs(title = "Estimated Likeability by Role and QRP Severity",
y = "Estimated Marginal Mean (Likeability)", x = "QRP Severity") +
theme_minimal(base_size = 13) +
coord_cartesian(ylim = c(1, 5))
# Trueness is only for investigators, one item per vignette
trueness_dat = filtered_by_age %>%
transmute(
responseid,
minor    = parse_num(kcon),
moderate = parse_num(hcon),
major    = parse_num(xcon)
) %>%
pivot_longer(
cols      = c(minor, moderate, major),
names_to  = "severity",
values_to = "trueness"
) %>%
mutate(
severity     = factor(severity, levels = c("minor", "moderate", "major")),
severity_num = case_when(
severity == "minor"    ~ -1,
severity == "moderate" ~  0,
severity == "major"    ~  1
),
responseid = factor(responseid),
trueness_c = trueness - 3
)
# Descriptives
trueness_dat %>%
group_by(severity) %>%
summarise(
n  = sum(!is.na(trueness)),
M  = round(mean(trueness, na.rm = TRUE), 2),
SD = round(sd(trueness,   na.rm = TRUE), 2),
.groups = "drop"
) %>%
kable(caption = "Trueness Descriptives by QRP Severity") %>%
kable_styling()
FT1 = lmer(
trueness_c ~ severity_num + (1 | responseid) + (1 | severity),
data    = trueness_dat,
REML    = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
summary(FT1)
# Planned contrasts across severity levels
emm_trueness = emmeans(FT1, pairwise ~ severity_num,
at     = list(severity_num = c(-1, 0, 1)),
adjust = "bonferroni")
summary(emm_trueness$contrasts)
eff_size(emmeans(FT1, ~ severity_num, at = list(severity_num = c(-1, 0, 1))),
sigma = sigma(FT1), edf = df.residual(FT1))
emm_true_df = as.data.frame(
emmeans(FT1, ~ severity_num, at = list(severity_num = c(-1, 0, 1)))
) %>%
mutate(Severity = factor(severity_num, levels = c(-1, 0, 1),
labels = c("Minor", "Moderate", "Major")))
ggplot(emm_true_df, aes(x = Severity, y = emmean, group = 1)) +
geom_line(linewidth = 1, color = "#7B1FA2") +
geom_point(size = 3, color = "#7B1FA2") +
geom_errorbar(aes(ymin = lower.CL, ymax = upper.CL), width = 0.15,
color = "#7B1FA2") +
labs(title = "Perceived Trueness of Finding by QRP Severity",
y = "Estimated Marginal Mean (Trueness)", x = "QRP Severity") +
theme_minimal(base_size = 13) +
coord_cartesian(ylim = c(1, 5))
emm_true_df = as.data.frame(
emmeans(FT1, ~ severity_num, at = list(severity_num = c(-1, 0, 1)))
) %>%
mutate(Severity = factor(severity_num, levels = c(-1, 0, 1),
labels = c("Minor", "Moderate", "Major")))
ggplot(emm_true_df, aes(x = Severity, y = emmean, group = 1)) +
geom_line(linewidth = 1, color = "#7B1FA2") +
geom_point(size = 3, color = "#7B1FA2") +
geom_errorbar(aes(ymin = lower.CL, ymax = upper.CL), width = 0.15,
color = "#7B1FA2") +
labs(title = "Perceived Trueness of Finding by QRP Severity",
y = "Estimated Marginal Mean (Trueness)", x = "QRP Severity") +
theme_minimal(base_size = 13) +
coord_cartesian()
# Refit model using RAW trueness (not centered)
FT1_raw <- lmer(
trueness ~ severity_num + (1 | responseid) + (1 | severity),
data    = trueness_dat,
REML    = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
# Estimated marginal means on the original 1–5 scale
emm_true_df_raw <- as.data.frame(
emmeans(FT1_raw, ~ severity_num,
at = list(severity_num = c(-1, 0, 1)))
) %>%
mutate(
Severity = factor(
severity_num,
levels = c(-1, 0, 1),
labels = c("Minor", "Moderate", "Major")
)
)
# Plot on the 1–5 scale
ggplot(emm_true_df_raw, aes(x = Severity, y = emmean, group = 1)) +
geom_line(linewidth = 1, color = "#7B1FA2") +
geom_point(size = 3, color = "#7B1FA2") +
geom_errorbar(aes(ymin = lower.CL, ymax = upper.CL),
width = 0.15, color = "#7B1FA2") +
labs(
title = "Perceived Trueness of Finding by QRP Severity",
y = "Estimated Marginal Mean (Trueness)",
x = "QRP Severity"
) +
theme_minimal(base_size = 13) +
coord_cartesian(ylim = c(1, 5))
