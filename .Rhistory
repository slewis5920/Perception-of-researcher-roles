control = lmerControl(optimizer = "bobyqa")
)
T4_prereg_singular = isSingular(T4_prereg, tol = 1e-4)
print(T4_prereg_singular)
# Decision rule used throughout the analysis:
# retain the vignette intercept if the preregistered structure is
# non-singular; otherwise use the participant-only structure.
Integrity_uses_vignette_term = !T4_prereg_singular
cat(
"Integrity final random-effects structure includes vignette intercept:",
Integrity_uses_vignette_term,
"\n"
)
if (Integrity_uses_vignette_term) {
random_part_Integrity = "vignette"
M0_Integrity = lmer(
Integrity ~ 1 +
(1 + role_ec | responseid) +
(1 | vignette_id),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
T1 = lmer(
Integrity ~ role_ec +
(1 + role_ec | responseid) +
(1 | vignette_id),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
T2 = lmer(
Integrity ~ severity_num +
(1 + role_ec | responseid) +
(1 | vignette_id),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
T3 = lmer(
Integrity ~ role_ec + severity_num +
(1 + role_ec | responseid) +
(1 | vignette_id),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
T4 = T4_prereg
} else {
random_part_Integrity = "participant_only"
M0_Integrity = lmer(
Integrity ~ 1 +
(1 + role_ec | responseid),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
T1 = lmer(
Integrity ~ role_ec +
(1 + role_ec | responseid),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
T2 = lmer(
Integrity ~ severity_num +
(1 + role_ec | responseid),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
T3 = lmer(
Integrity ~ role_ec + severity_num +
(1 + role_ec | responseid),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
T4 = T4_max3
}
# Singularity checks for final models.
cat("Integrity final model singularity:\n")
print(isSingular(M0_Integrity))
print(isSingular(T1))
print(isSingular(T2))
print(isSingular(T3))
print(isSingular(T4))
# Complete step-up comparison, including Model 0.
integrity_models = list(
M0_Integrity,
T1,
T2,
T3,
T4
)
integrity_model_names = c(
"Model 0: Null",
"Model 1: Role",
"Model 2: QRP Severity",
"Model 3: Role + QRP Severity",
"Model 4: Role × QRP Severity"
)
integrity_fit = model_fit_table(
integrity_models,
integrity_model_names
)
print(integrity_fit)
# Full model summaries.
summary(T1)
summary(T2)
summary(T3)
summary(T4)
# Fixed effects from every model, including Satterthwaite df, t, and p.
integrity_fixed_effects = lapply(
integrity_models,
get_fixed_effects
)
names(integrity_fixed_effects) = paste0("Model_", 0:4)
print(integrity_fixed_effects)
# Planned comparison: inspectors versus investigators at each severity.
# Bonferroni correction is applied across the three severity-specific
# role comparisons.
emm_Integrity = emmeans(
T4,
~ role_ec | severity_num,
at = list(severity_num = c(-1, 0, 1))
)
emm_Integrity_role = emmeans(
T4,
pairwise ~ role_ec | severity_num,
at = list(severity_num = c(-1, 0, 1)),
adjust = "bonferroni"
)
summary(emm_Integrity_role$contrasts)
# Cohen's d for each role contrast.
eff_size(
emm_Integrity,
sigma = sigma(T4),
edf = df.residual(T4)
)
emm_Integrity_df = as.data.frame(
emmeans(
T4,
~ role_ec * severity_num,
at = list(severity_num = c(-1, 0, 1))
)
) %>%
mutate(
Role = if_else(
role_ec == 1,
"Inspector",
"Investigator"
),
Severity = factor(
severity_num,
levels = c(-1, 0, 1),
labels = c("Minor", "Moderate", "Major")
)
)
ggplot(
emm_Integrity_df,
aes(
x = Severity,
y = emmean,
color = Role,
group = Role
)
) +
geom_line(linewidth = 1) +
geom_point(size = 3) +
geom_errorbar(
aes(ymin = lower.CL, ymax = upper.CL),
width = 0.15
) +
scale_color_manual(
values = c(
"Inspector" = "#2196F3",
"Investigator" = "#E53935"
)
) +
labs(
title = "RQ1. Integrity",
y = "Integrity (EMM)",
x = "QRP Severity"
) +
theme_minimal(base_size = 13) +
coord_cartesian(ylim = c(1, 5))
# ------------------------------------------------------------
# Maximal participant-level structure
# ------------------------------------------------------------
L4_max1 = lmer(
likeability ~ role_ec * severity_num +
(1 + role_ec * severity_num | responseid),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
L4_max1_singular = isSingular(L4_max1, tol = 1e-4)
print(L4_max1_singular)
# Step down: remove random interaction slope.
L4_max2 = lmer(
likeability ~ role_ec * severity_num +
(1 + role_ec + severity_num | responseid),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
L4_max2_singular = isSingular(L4_max2, tol = 1e-4)
print(L4_max2_singular)
# Step down: retain random role slope only.
L4_max3 = lmer(
likeability ~ role_ec * severity_num +
(1 + role_ec | responseid),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
L4_max3_singular = isSingular(L4_max3, tol = 1e-4)
print(L4_max3_singular)
# Test preregistered vignette random intercept with the maximal
# participant-level structure.
L4_prereg = lmer(
likeability ~ role_ec * severity_num +
(1 + role_ec * severity_num | responseid) +
(1 | vignette_id),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
L4_prereg_singular = isSingular(L4_prereg, tol = 1e-4)
print(L4_prereg_singular)
likeability_uses_vignette_term = !L4_prereg_singular
cat(
"Likeability final random-effects structure includes vignette intercept:",
likeability_uses_vignette_term,
"\n"
)
# ------------------------------------------------------------
# Fit Models 0–4 using ONE identical random-effects structure.
# ------------------------------------------------------------
if (likeability_uses_vignette_term) {
random_part_likeability = "participant_maximal_plus_vignette"
M0_like = lmer(
likeability ~ 1 +
(1 + role_ec * severity_num | responseid) +
(1 | vignette_id),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
L1 = lmer(
likeability ~ role_ec +
(1 + role_ec * severity_num | responseid) +
(1 | vignette_id),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
L2 = lmer(
likeability ~ severity_num +
(1 + role_ec * severity_num | responseid) +
(1 | vignette_id),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
L3 = lmer(
likeability ~ role_ec + severity_num +
(1 + role_ec * severity_num | responseid) +
(1 | vignette_id),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
L4 = L4_prereg
} else {
random_part_likeability = "participant_maximal"
M0_like = lmer(
likeability ~ 1 +
(1 + role_ec * severity_num | responseid),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
L1 = lmer(
likeability ~ role_ec +
(1 + role_ec * severity_num | responseid),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
L2 = lmer(
likeability ~ severity_num +
(1 + role_ec * severity_num | responseid),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
L3 = lmer(
likeability ~ role_ec + severity_num +
(1 + role_ec * severity_num | responseid),
data = tl_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
L4 = L4_max1
}
cat("Likeability final model singularity:\n")
print(isSingular(M0_like))
print(isSingular(L1))
print(isSingular(L2))
print(isSingular(L3))
print(isSingular(L4))
likeability_models = list(
M0_like,
L1,
L2,
L3,
L4
)
likeability_model_names = c(
"Model 0: Null",
"Model 1: Role",
"Model 2: QRP Severity",
"Model 3: Role + QRP Severity",
"Model 4: Role × QRP Severity"
)
likeability_fit = model_fit_table(
likeability_models,
likeability_model_names
)
print(likeability_fit)
summary(L1)
summary(L2)
summary(L3)
summary(L4)
likeability_fixed_effects = lapply(
likeability_models,
get_fixed_effects
)
names(likeability_fixed_effects) = paste0("Model_", 0:4)
print(likeability_fixed_effects)
# Planned role comparisons at each severity.
emm_like_role = emmeans(
L4,
pairwise ~ role_ec | severity_num,
at = list(severity_num = c(-1, 0, 1)),
adjust = "bonferroni"
)
summary(emm_like_role$contrasts)
# Cohen's d for each role comparison.
eff_size(
emmeans(
L4,
~ role_ec | severity_num,
at = list(severity_num = c(-1, 0, 1))
),
sigma = sigma(L4),
edf = df.residual(L4)
)
emm_like_df = as.data.frame(
emmeans(
L4,
~ role_ec * severity_num,
at = list(severity_num = c(-1, 0, 1))
)
) %>%
mutate(
Role = if_else(
role_ec == 1,
"Inspector",
"Investigator"
),
Severity = factor(
severity_num,
levels = c(-1, 0, 1),
labels = c("Minor", "Moderate", "Major")
)
)
ggplot(
emm_like_df,
aes(
x = Severity,
y = emmean,
color = Role,
group = Role
)
) +
geom_line(linewidth = 1) +
geom_point(size = 3) +
geom_errorbar(
aes(ymin = lower.CL, ymax = upper.CL),
width = 0.15
) +
scale_color_manual(
values = c(
"Inspector" = "#2196F3",
"Investigator" = "#E53935"
)
) +
labs(
title = "Likeability",
y = "Likeability (EMM)",
x = "QRP Severity"
) +
theme_minimal(base_size = 13) +
coord_cartesian(ylim = c(1, 5))
# Trueness is only rated for investigators, with one item per vignette.
trueness_dat = filtered_by_age %>%
transmute(
responseid,
minor = parse_num(kcon),
moderate = parse_num(hcon),
major = parse_num(xcon)
) %>%
pivot_longer(
cols = c(minor, moderate, major),
names_to = "severity",
values_to = "trueness"
) %>%
mutate(
severity = factor(
severity,
levels = c("minor", "moderate", "major")
),
severity_num = case_when(
severity == "minor" ~ -1,
severity == "moderate" ~ 0,
severity == "major" ~ 1
),
responseid = factor(responseid),
trueness_c = trueness - 3
)
# Descriptives.
trueness_descriptives = trueness_dat %>%
group_by(severity) %>%
summarise(
n = sum(!is.na(trueness)),
M = round(mean(trueness, na.rm = TRUE), 2),
SD = round(sd(trueness, na.rm = TRUE), 2),
.groups = "drop"
)
print(trueness_descriptives)
range(trueness_dat$trueness, na.rm = TRUE)
mean(trueness_dat$trueness, na.rm = TRUE)
# FT1: perceived trueness predicted by QRP severity.
FT1 = lmer(
trueness_c ~ severity_num +
(1 | responseid) +
(1 | severity),
data = trueness_dat,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
summary(FT1)
isSingular(FT1)
# Fixed effects, including Satterthwaite df, t, and p.
trueness_fixed_effects = get_fixed_effects(FT1)
print(trueness_fixed_effects)
# Planned comparisons across severity levels.
emm_trueness = emmeans(
FT1,
pairwise ~ severity_num,
at = list(severity_num = c(-1, 0, 1)),
adjust = "bonferroni"
)
summary(emm_trueness$contrasts)
eff_size(
emmeans(
FT1,
~ severity_num,
at = list(severity_num = c(-1, 0, 1))
),
sigma = sigma(FT1),
edf = df.residual(FT1)
)
# Trueness is only rated for investigators, with one item per vignette.
trueness_dat = filtered_by_age %>%
transmute(
responseid,
minor = parse_num(kcon),
moderate = parse_num(hcon),
major = parse_num(xcon)
) %>%
pivot_longer(
cols = c(minor, moderate, major),
names_to = "severity",
values_to = "trueness"
) %>%
mutate(
severity = factor(
severity,
levels = c("minor", "moderate", "major")
),
severity_num = case_when(
severity == "minor" ~ -1,
severity == "moderate" ~ 0,
severity == "major" ~ 1
),
responseid = factor(responseid),
trueness_c = trueness - 3
)
# Descriptives.
trueness_descriptives = trueness_dat %>%
group_by(severity) %>%
summarise(
n = sum(!is.na(trueness)),
M = round(mean(trueness, na.rm = TRUE), 2),
SD = round(sd(trueness, na.rm = TRUE), 2),
.groups = "drop"
)
print(trueness_descriptives)
