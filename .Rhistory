),
sprintf(
"%.1f",
AIC(FT1)
),
sprintf(
"%.1f",
BIC(FT1)
)
),
SE = c(
sprintf(
"%.2f",
ft1["(Intercept)", "Std. Error"]
),
sprintf(
"%.2f",
ft1["severity_num", "Std. Error"]
),
"", "", "", "", "", "", ""
),
p = c(
fmt_p(
ft1["(Intercept)", "Pr(>|t|)"]
),
fmt_p(
ft1["severity_num", "Pr(>|t|)"]
),
"", "", "", "", "", "", ""
),
stringsAsFactors = FALSE
)
# Print Table 10
trueness_df %>%
kable(
caption =
"Table 10. MLM Results for Perceived Trueness of Finding",
col.names = c(
"Parameter",
"b",
"SE",
"p"
),
align = c(
"l",
"r",
"r",
"r"
),
escape = FALSE
) %>%
kable_styling(
full_width = FALSE,
font_size = 11,
bootstrap_options =
c(
"condensed",
"bordered"
)
) %>%
footnote(
general =
"Trueness was centered at 3 (neutral). QRP Severity was effect coded as minor = −1, moderate = 0, and major = 1. * p < .05. ** p < .01. *** p < .001.",
general_title =
"Note.",
footnote_as_chunk =
TRUE
)
cat("\n--- Integrity random effects ---\n")
print(get_variance_components(T4))
print(get_random_intercept_icc(T4))
cat("\n--- Likeability random effects ---\n")
print(get_variance_components(L4))
print(get_random_intercept_icc(L4))
cat("\n--- Trueness random effects ---\n")
print(get_variance_components(FT1))
print(get_random_intercept_icc(FT1))
# Load packages
library(dplyr)
library(tidyr)
library(lavaan)
library(semTools)
# 1. Create participant-level data
cfa_dat <- tl_dat %>%
group_by(responseid, role) %>%
summarise(
hon  = mean(hon_raw,  na.rm = TRUE),
sin  = mean(sin_raw,  na.rm = TRUE),
eth  = mean(eth_raw,  na.rm = TRUE),
like = mean(like_raw, na.rm = TRUE),
app  = mean(app_raw,  na.rm = TRUE),
.groups = "drop"
)
# 2. One-factor model
one_factor <- '
Evaluation =~ hon + sin + eth + like + app
'
# Investigator: one-factor model
investigator_one <- cfa(
one_factor,
data = cfa_dat %>% filter(role == "investigator"),
missing = "fiml"
)
# Inspector: one-factor model
inspector_one <- cfa(
one_factor,
data = cfa_dat %>% filter(role == "inspector"),
missing = "fiml"
)
# 3. Two-factor model
two_factor <- '
Integrity =~ hon + sin + eth
Likeability =~ like + app
'
# Investigator: two-factor model
investigator_two <- cfa(
two_factor,
data = cfa_dat %>% filter(role == "investigator"),
missing = "fiml"
)
# Inspector: two-factor model
inspector_two <- cfa(
two_factor,
data = cfa_dat %>% filter(role == "inspector"),
missing = "fiml"
)
# 4. Print model results
cat("\n================ INVESTIGATOR: ONE FACTOR ================\n")
summary(
investigator_one,
fit.measures = TRUE,
standardized = TRUE
)
cat("\n================ INVESTIGATOR: TWO FACTORS ================\n")
summary(
investigator_two,
fit.measures = TRUE,
standardized = TRUE
)
cat("\n================ INSPECTOR: ONE FACTOR ================\n")
summary(
inspector_one,
fit.measures = TRUE,
standardized = TRUE
)
cat("\n================ INSPECTOR: TWO FACTORS ================\n")
summary(
inspector_two,
fit.measures = TRUE,
standardized = TRUE
)
# 5. Compare one-factor vs. two-factor models
cat("\n================ MODEL COMPARISONS ================\n")
cat("\nInvestigator:\n")
anova(
investigator_one,
investigator_two
)
cat("\nInspector:\n")
anova(
inspector_one,
inspector_two
)
# ============================================================
# 6. Create easy-to-read fit table
# ============================================================
fit_table <- rbind(
Investigator_1Factor = fitMeasures(
investigator_one,
c("chisq", "df", "cfi", "tli", "rmsea", "srmr")
),
Investigator_2Factor = fitMeasures(
investigator_two,
c("chisq", "df", "cfi", "tli", "rmsea", "srmr")
),
Inspector_1Factor = fitMeasures(
inspector_one,
c("chisq", "df", "cfi", "tli", "rmsea", "srmr")
),
Inspector_2Factor = fitMeasures(
inspector_two,
c("chisq", "df", "cfi", "tli", "rmsea", "srmr")
)
)
cat("\n================ FIT TABLE ================\n")
print(round(fit_table, 3))
# ============================================================
# 7. Measurement invariance across researcher role
# ============================================================
# ONLY run/interpret this section if the two-factor model
# provides a reasonable fit.
#
# Configural = same factor structure
# Metric     = equal factor loadings
# Scalar     = equal loadings + intercepts
cat("\n================ CONFIGURAL INVARIANCE ================\n")
configural <- cfa(
two_factor,
data = cfa_dat,
group = "role",
missing = "fiml"
)
summary(
configural,
fit.measures = TRUE,
standardized = TRUE
)
cat("\n================ METRIC INVARIANCE ================\n")
metric <- cfa(
two_factor,
data = cfa_dat,
group = "role",
group.equal = "loadings",
missing = "fiml"
)
summary(
metric,
fit.measures = TRUE,
standardized = TRUE
)
cat("\n================ SCALAR INVARIANCE ================\n")
scalar <- cfa(
two_factor,
data = cfa_dat,
group = "role",
group.equal = c("loadings", "intercepts"),
missing = "fiml"
)
summary(
scalar,
fit.measures = TRUE,
standardized = TRUE
)
# 8. Compare invariance models
cat("\n================ INVARIANCE MODEL COMPARISON ================\n")
anova(
configural,
metric,
scalar
)
# 9. Invariance fit table
invariance_fit_table <- rbind(
Configural = fitMeasures(
configural,
c("chisq", "df", "cfi", "tli", "rmsea", "srmr")
),
Metric = fitMeasures(
metric,
c("chisq", "df", "cfi", "tli", "rmsea", "srmr")
),
Scalar = fitMeasures(
scalar,
c("chisq", "df", "cfi", "tli", "rmsea", "srmr")
)
)
cat("\n================ INVARIANCE FIT TABLE ================\n")
print(round(invariance_fit_table, 3))
vignette_id = factor(severity)
table(attr_long$severity, useNA = "ifany")
table(attr_model_dat$severity, useNA = "ifany")
table(attr_long2$severity, attr_long2$attribute, useNA = "ifany")
table(attr_model_dat$severity, attr_model_dat$attribute, useNA = "ifany")
table(attr_model_dat$researcher, attr_model_dat$chosen)
summary(A1)
summary(A2)
summary(A3)
summary(A4)
contrasts(attr_model_dat$attribute)
# Pivot the dataset
attr_long = attr_dat %>%
pivot_longer(
cols = -responseid,
names_to = "raw_item",
values_to = "choice_raw"
)
# Find the correct columns to attribute to the variables
attr_long = attr_long %>%
mutate(
severity = case_when(
str_detect(raw_item, "^min") ~ "minor",
str_detect(raw_item, "^mod") ~ "moderate",
str_detect(raw_item, "^maj") ~ "major",
TRUE ~ NA_character_
),
attribute = case_when(
str_detect(raw_item, "smart$") ~ "smarter",
str_detect(raw_item, "bett(er)?$|bet$") ~ "better_researcher",
str_detect(raw_item, "creat(ive)?$") ~ "creative",
str_detect(raw_item, "rath(er)?$") ~ "rather_be",
str_detect(raw_item, "shou(ld)?$") ~ "should_be",
str_detect(raw_item, "reg(ard)?$") ~ "celebrated",
str_detect(raw_item, "typ$") ~ "typical",
str_detect(raw_item, "keep$") ~ "job_security",
str_detect(raw_item, "get$") ~ "job_outcome",
TRUE ~ NA_character_
)
)
# Check to make sure it looks correct and get a count
head(attr_long, 20)
table(attr_long$severity, useNA = "ifany")
table(attr_long$attribute, useNA = "ifany")
# Set roles
attr_long2 = attr_long %>%
tidyr::crossing(
researcher = c("investigator", "inspector")
)
# Figure out how many rows for the data
head(attr_long2, 20)
dim(attr_long)
dim(attr_long2)
# Find the correct columns and attribute them to role type
attr_long2 = attr_long2 %>%
mutate(
chosen = case_when(
str_detect(choice_raw, "^reported researcher") &
researcher == "investigator" ~ 1,
str_detect(choice_raw, "^reporting researcher") &
researcher == "inspector" ~ 1,
str_detect(choice_raw, "^neither") ~ 0,
TRUE ~ 0
)
)
# Check to make sure it looks correct and get a count
head(attr_long2, 20)
table(attr_long2$chosen, useNA = "ifany")
table(attr_long2$researcher, attr_long2$chosen)
# Set up the data for the models
attr_model_dat = attr_long2 %>%
mutate(
researcher_ec = if_else(
researcher == "inspector",
1,
-1
),
severity_num = case_when(
severity == "minor" ~ -1,
severity == "moderate" ~ 0,
severity == "major" ~ 1
),
responseid = factor(responseid),
researcher = factor(
researcher,
levels = c("investigator", "inspector")
),
severity = factor(
severity,
levels = c("minor", "moderate", "major")
),
attribute = factor(
attribute,
levels = c(
"smarter",
"better_researcher",
"creative",
"rather_be",
"should_be",
"celebrated",
"typical",
"job_security",
"job_outcome"
)
),
vignette_id = factor(severity)
)
# Create some model tables
str(attr_model_dat)
table(attr_model_dat$researcher)
table(attr_model_dat$severity)
table(attr_model_dat$attribute, useNA = "ifany")
table(attr_model_dat$researcher_ec)
table(attr_model_dat$severity_num)
# Set attribute comparisons to the grand mean rather than using
# one attribute as the reference category
contrasts(attr_model_dat$attribute) <- contr.sum(
nlevels(attr_model_dat$attribute)
)
# Check the contrasts
contrasts(attr_model_dat$attribute)
# Run our first model in the model building for the exploratory analysis
A1 = glmer(
chosen ~ researcher_ec + attribute +
(1 | responseid) + (1 | vignette_id),
data = attr_model_dat,
family = binomial,
control = glmerControl(optimizer = "bobyqa")
)
# A2 tests whether choice differs by severity, controlling for attribute
A2 = glmer(
chosen ~ attribute + severity_num +
(1 | responseid) + (1 | vignette_id),
data = attr_model_dat,
family = binomial,
control = glmerControl(
optimizer = "bobyqa",
optCtrl = list(maxfun = 2e5)
)
)
# A3 tests whether choice differs by BOTH researcher and severity,
# while controlling for attribute
A3 = glmer(
chosen ~ researcher_ec + attribute + severity_num +
(1 | responseid) + (1 | vignette_id),
data = attr_model_dat,
family = binomial,
control = glmerControl(
optimizer = "bobyqa",
optCtrl = list(maxfun = 2e5)
)
)
# A4 tests whether the effect of researcher depends on severity,
# while controlling for attribute
A4 = glmer(
chosen ~ researcher_ec * severity_num + attribute +
(1 | responseid) + (1 | vignette_id),
data = attr_model_dat,
family = binomial,
control = glmerControl(
optimizer = "bobyqa",
optCtrl = list(maxfun = 2e5)
)
)
# Summarize models
summary(A1)
summary(A2)
summary(A3)
summary(A4)
# Get the number and percentage of participants who chose
# each researcher for each attribute and vignette
attribute_descriptives = attr_model_dat %>%
group_by(vignette_id, severity_num, attribute, researcher_ec) %>%
summarise(
N = sum(chosen == 1, na.rm = TRUE),
.groups = "drop"
) %>%
group_by(vignette_id, severity_num, attribute) %>%
mutate(
Total_N = sum(N),
Percent = round(N / Total_N * 100, 2)
) %>%
tidyr::pivot_wider(
names_from = researcher_ec,
values_from = c(N, Percent),
values_fill = 0,
names_glue = "{.value}_{researcher_ec}"
) %>%
rename(
Investigator_N = `N_-1`,
Inspector_N = `N_1`,
Investigator_Percent = `Percent_-1`,
Inspector_Percent = `Percent_1`
) %>%
ungroup()
print(attribute_descriptives, n = 27)
### 5. Overall attribute test + pairwise comparisons
# Test the overall effect of attribute
anova(A4, test = "Chisq")
# Get estimated marginal means for each attribute
library(emmeans)
attribute_emmeans = emmeans(
A4,
~ attribute,
type = "response"
)
print(attribute_emmeans)
# Compare attributes to each other
pairs(
attribute_emmeans,
adjust = "bonferroni"
)
# Create APA-style table of researcher choices by attribute and severity
attribute_table = attribute_descriptives %>%
mutate(
Investigator = paste0(
Investigator_N, " (", Investigator_Percent, "%)"
),
Inspector = paste0(
Inspector_N, " (", Inspector_Percent, "%)"
)
) %>%
select(
severity = vignette_id,
attribute,
Investigator,
Inspector
) %>%
tidyr::pivot_wider(
names_from = severity,
values_from = c(Investigator, Inspector)
) %>%
select(
attribute,
Investigator_minor,
Inspector_minor,
Investigator_moderate,
Inspector_moderate,
Investigator_major,
Inspector_major
)
knitr::kable(
attribute_table,
caption = "Researcher Selections for Positive Attributes by QRP Severity",
col.names = c(
"Attribute",
"Investigator",
"Inspector",
"Investigator",
"Inspector",
"Investigator",
"Inspector"
),
align = c("l", "c", "c", "c", "c", "c", "c")
)
