# Attach demographics to tl_dat
demo_dat = filtered_by_age %>%
transmute(
responseid = responseid,
gender     = factor(`gender.identity`),
political  = factor(political, levels = c(
"Strongly Liberal", "Liberal", "Lean Liberal",
"Centrist",
"Lean Conservative", "Conservative", "Strongly Conservative"
)),
religion   = factor(religion)
)
tl_robust = tl_dat %>%
mutate(responseid = as.character(responseid)) %>%
left_join(demo_dat, by = "responseid") %>%
mutate(responseid = factor(responseid))
# Trust robustness model (Model 4 + demographics)
T4_robust = lmer(
trust ~ role_ec * severity_num + gender + political + religion +
(1 | responseid) + (1 | severity),
data    = tl_robust,
REML    = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
L4_robust = lmer(
likeability ~ role_ec * severity_num + gender + political + religion +
(1 | responseid) + (1 | severity),
data    = tl_robust,
REML    = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
summary(L4_robust)
# Compare role_ec * severity_num effect with and without demographics
summary(T4_robust)
summary(L4_robust)
# Check if the interaction term stays significant in both
fixef(T4)[["role_ec:severity_num"]]
fixef(T4_robust)[["role_ec:severity_num"]]
fixef(L4)[["role_ec:severity_num"]]
fixef(L4_robust)[["role_ec:severity_num"]]
# Attach demographics to tl_dat
demo_dat = filtered_by_age %>%
transmute(
responseid = responseid,
gender     = factor(`gender.identity`),
political  = factor(political, levels = c(
"Strongly Liberal", "Liberal", "Lean Liberal",
"Centrist",
"Lean Conservative", "Conservative", "Strongly Conservative"
)),
religion   = factor(religion)
)
tl_robust = tl_dat %>%
mutate(responseid = as.character(responseid)) %>%
left_join(demo_dat, by = "responseid") %>%
mutate(responseid = factor(responseid))
# Trust robustness model (Model 4 + demographics)
T4_robust = lmer(
trust ~ role_ec * severity_num + gender + political + religion +
(1 | responseid) + (1 | severity),
data    = tl_robust,
REML    = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
L4_robust = lmer(
likeability ~ role_ec * severity_num + gender + political + religion +
(1 | responseid) + (1 | severity),
data    = tl_robust,
REML    = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
summary(L4_robust)
# Compare role_ec * severity_num effect with and without demographics
summary(T4_robust)
summary(L4_robust)
# Check if the interaction term stays significant in both
fixef(T4)[["role_ec:severity_num"]]
fixef(T4_robust)[["role_ec:severity_num"]]
fixef(L4)[["role_ec:severity_num"]]
fixef(L4_robust)[["role_ec:severity_num"]]
tl_robust$ideology_num <- as.numeric(tl_robust$political)
# Center it for interpretation
tl_robust$ideology_c <- scale(tl_robust$ideology_num, scale = FALSE)
trust_mod_ideo <- lmer(
trust ~ role_ec * severity_num * ideology_c +
gender + political + religion +
(1 | responseid) + (1 | severity),
data = tl_robust,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
summary(trust_mod_ideo)
library(emmeans)
emm_ideo <- emmeans(
trust_mod_ideo,
~ role_ec * severity_num | ideology_c,
at = list(
ideology_c = c(
mean(tl_robust$ideology_c) - sd(tl_robust$ideology_c),
mean(tl_robust$ideology_c),
mean(tl_robust$ideology_c) + sd(tl_robust$ideology_c)
),
severity_num = c(-1, 0, 1)
)
)
emm_ideo
pairs(emm_ideo)
trust_mod_pol <- lmer(
trust ~ role_ec * severity_num * ideology_c +
(1 | responseid) + (1 | severity),
data = tl_robust,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
summary(trust_mod_pol)
emm_pol <- emmeans(
trust_mod_pol,
~ role_ec * severity_num | ideology_c,
at = list(
ideology_c = c(
mean(tl_robust$ideology_c) - sd(tl_robust$ideology_c),
mean(tl_robust$ideology_c),
mean(tl_robust$ideology_c) + sd(tl_robust$ideology_c)
),
severity_num = c(-1, 0, 1)
)
)
tl_robust$ideology_num <- as.numeric(tl_robust$political)
tl_robust$ideology_c <- scale(tl_robust$ideology_num, scale = FALSE)
trust_mod_pol <- lmer(
trust ~ role_ec * severity_num * ideology_c +
(1 | responseid) + (1 | severity),
data = tl_robust,
REML = FALSE,
control = lmerControl(optimizer = "bobyqa")
)
summary(trust_mod_pol)
emm_pol <- emmeans(
trust_mod_pol,
~ role_ec * severity_num | ideology_c,
at = list(
ideology_c = c(
mean(tl_robust$ideology_c) - sd(tl_robust$ideology_c),
mean(tl_robust$ideology_c),
mean(tl_robust$ideology_c) + sd(tl_robust$ideology_c)
),
severity_num = c(-1, 0, 1)
)
)
emm_pol
pairs(emm_pol)
library(emmeans)
ideo_vals <- c(
mean(tl_robust$ideology_c) - sd(tl_robust$ideology_c),
mean(tl_robust$ideology_c),
mean(tl_robust$ideology_c) + sd(tl_robust$ideology_c)
)
emm_ideo <- emmeans(
trust_mod_pol,
~ role_ec * severity_num | ideology_c,
at = list(
ideology_c = ideo_vals,
severity_num = c(-1, 0, 1)
)
)
emm_ideo
pairs(emm_ideo)
emm_pol_df <- as.data.frame(emm_pol)
ggplot(emm_pol_df,
aes(x = severity_num, y = emmean,
color = factor(ideology_c), group = factor(ideology_c))) +
geom_line(size = 1.1) +
geom_point(size = 3) +
facet_wrap(~ role_ec) +
labs(
title = "Political Ideology Moderates the Role × Severity Effect on Trust",
x = "QRP Severity",
y = "Estimated Trust",
color = "Ideology Level"
) +
theme_minimal(base_size = 14)
