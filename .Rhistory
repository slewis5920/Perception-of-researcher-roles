attention1,
ethnic, race, race.other, gender.identity,
q78, education, political, sex.orientation,
q92, old, religion, religion.other,
id)
# Initial data count to see what in the data set
initial_count = nrow(Diss.subsetscoring)
# Filter by consent
filtered_by_consent = Diss.subsetscoring %>%
filter(consent.form. == 1)
count_by_consent = nrow(filtered_by_consent)
