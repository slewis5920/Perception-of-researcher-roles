Parameter =
re_grps[grp],
M0_b = vals[1],
M0_se = "",
M0_p = "",
M1_b = vals[2],
M1_se = "",
M1_p = "",
M2_b = vals[3],
M2_se = "",
M2_p = "",
M3_b = vals[4],
M3_se = "",
M3_p = "",
M4_b = vals[5],
M4_se = "",
M4_p = "",
stringsAsFactors = FALSE
)
}
)
re_df =
do.call(
rbind,
re_rows
)
# ──────────────────────────────────────────────────────────
# ICC
# ──────────────────────────────────────────────────────────
icc_rows =
lapply(
c(
"responseid",
"vignette_id"
),
function(grp) {
vals =
sapply(
icc_list,
function(ic) {
if (grp %in% names(ic)) {
as.character(
ic[grp]
)
} else {
"—"
}
}
)
label =
ifelse(
grp == "responseid",
"ICC: Participant",
"ICC: Vignette"
)
data.frame(
Parameter = label,
M0_b = vals[1],
M0_se = "",
M0_p = "",
M1_b = vals[2],
M1_se = "",
M1_p = "",
M2_b = vals[3],
M2_se = "",
M2_p = "",
M3_b = vals[4],
M3_se = "",
M3_p = "",
M4_b = vals[5],
M4_se = "",
M4_p = "",
stringsAsFactors = FALSE
)
}
)
icc_df =
do.call(
rbind,
icc_rows
)
# ──────────────────────────────────────────────────────────
# AIC and BIC
# ──────────────────────────────────────────────────────────
fit_vals =
sapply(
models,
function(m) {
c(
AIC = round(
AIC(m),
1
),
BIC = round(
BIC(m),
1
)
)
}
)
fit_df =
data.frame(
Parameter =
c(
"AIC",
"BIC"
),
M0_b =
as.character(
fit_vals[, 1]
),
M0_se = "",
M0_p = "",
M1_b =
as.character(
fit_vals[, 2]
),
M1_se = "",
M1_p = "",
M2_b =
as.character(
fit_vals[, 3]
),
M2_se = "",
M2_p = "",
M3_b =
as.character(
fit_vals[, 4]
),
M3_se = "",
M3_p = "",
M4_b =
as.character(
fit_vals[, 5]
),
M4_se = "",
M4_p = "",
stringsAsFactors = FALSE
)
# ──────────────────────────────────────────────────────────
# Model comparison χ²
# ──────────────────────────────────────────────────────────
comparisons = list()
for (i in 2:5) {
comp =
anova(
models[[i - 1]],
models[[i]]
)
chi =
comp$Chisq[2]
df =
comp$Df[2]
p =
comp$`Pr(>Chisq)`[2]
comparisons[[i - 1]] =
c(
chi,
df,
p
)
}
comparison_df =
data.frame(
Parameter =
c(
"Model comparison χ²",
"Model comparison df",
"Model comparison p"
),
M0_b = "—",
M0_se = "",
M0_p = "",
M1_b =
as.character(
round(
comparisons[[1]][1],
2
)
),
M1_se =
as.character(
comparisons[[1]][2]
),
M1_p =
fmt_p(
comparisons[[1]][3]
),
M2_b =
as.character(
round(
comparisons[[2]][1],
2
)
),
M2_se =
as.character(
comparisons[[2]][2]
),
M2_p =
fmt_p(
comparisons[[2]][3]
),
M3_b =
as.character(
round(
comparisons[[3]][1],
2
)
),
M3_se =
as.character(
comparisons[[3]][2]
),
M3_p =
fmt_p(
comparisons[[3]][3]
),
M4_b =
as.character(
round(
comparisons[[4]][1],
2
)
),
M4_se =
as.character(
comparisons[[4]][2]
),
M4_p =
fmt_p(
comparisons[[4]][3]
),
stringsAsFactors = FALSE
)
# ──────────────────────────────────────────────────────────
# Combine everything
# ──────────────────────────────────────────────────────────
full_df =
rbind(
fe_df,
re_df,
icc_df,
fit_df,
comparison_df
)
# ──────────────────────────────────────────────────────────
# Print table
# ──────────────────────────────────────────────────────────
full_df %>%
kable(
caption =
caption_text,
col.names =
c(
"Parameter",
"b", "SE", "p",
"b", "SE", "p",
"b", "SE", "p",
"b", "SE", "p",
"b", "SE", "p"
),
align =
c(
"l",
rep(
"r",
15
)
),
escape = FALSE
) %>%
kable_styling(
full_width = TRUE,
font_size = 11,
bootstrap_options =
c(
"condensed",
"bordered"
)
) %>%
# THIS WAS THE MAIN ALIGNMENT ERROR
add_header_above(
c(
" " = 2,
"Model 0" = 3,
"Model 1" = 3,
"Model 2" = 3,
"Model 3" = 3,
"Model 4" = 3
)
) %>%
footnote(
general =
footnote_text,
general_title =
"Note.",
footnote_as_chunk =
TRUE
)
}
# ── INTEGRITY TABLE ─────────────────────────────────────────
make_stepup_table(
m0 = M0_Integrity,
m1 = T1,
m2 = T2,
m3 = T3,
m4 = T4,
caption_text =
"Table 8. Step-Up MLM Results for Integrity Ratings",
footnote_text =
"Role was effect coded as inspector = 1 and investigator = −1. QRP Severity was effect coded as minor = −1, moderate = 0, and major = 1. Model comparison χ² values are likelihood-ratio tests comparing each model with the preceding model. * p < .05. ** p < .01. *** p < .001."
)
# ── LIKEABILITY TABLE ───────────────────────────────────────
make_stepup_table(
m0 = M0_like,
m1 = L1,
m2 = L2,
m3 = L3,
m4 = L4,
caption_text =
"Table 9. Step-Up MLM Results for Likeability Ratings",
footnote_text =
"Role was effect coded as inspector = 1 and investigator = −1. QRP Severity was effect coded as minor = −1, moderate = 0, and major = 1. Model comparison χ² values are likelihood-ratio tests comparing each model with the preceding model. * p < .05. ** p < .01. *** p < .001."
)
# ─────────────────────────────────────────────────────────────
# TABLE 10: PERCEIVED TRUENESS OF FINDING
# ─────────────────────────────────────────────────────────────
# Fixed effects
ft1 <- summary(FT1)$coefficients
# Random effects
ft1_vc <- as.data.frame(
lme4::VarCorr(FT1)
)
# Extract variance components
participant_var <- ft1_vc$vcov[
ft1_vc$grp == "responseid"
]
vignette_var <- ft1_vc$vcov[
ft1_vc$grp == "severity"
]
residual_var <- ft1_vc$vcov[
ft1_vc$grp == "Residual"
]
# Total variance
total_var <-
participant_var +
vignette_var +
residual_var
# ICCs
participant_icc <-
participant_var / total_var
vignette_icc <-
vignette_var / total_var
# ─────────────────────────────────────────────────────────────
# Create table
# ─────────────────────────────────────────────────────────────
trueness_df <- data.frame(
Parameter = c(
"Intercept",
"QRP Severity",
"Participant variance",
"Vignette variance",
"Residual variance",
"ICC: Participant",
"ICC: Vignette",
"AIC",
"BIC"
),
b = c(
sprintf(
"%.2f",
ft1["(Intercept)", "Estimate"]
),
sprintf(
"%.2f",
ft1["severity_num", "Estimate"]
),
sprintf(
"%.3f",
participant_var
),
sprintf(
"%.3f",
vignette_var
),
sprintf(
"%.3f",
residual_var
),
sprintf(
"%.3f",
participant_icc
),
sprintf(
"%.3f",
vignette_icc
),
sprintf(
"%.1f",
AIC(FT1)
),
sprintf(
"%.1f",
BIC(FT1)
)
),
SE = c(
sprintf(
"%.2f",
ft1["(Intercept)", "Std. Error"]
),
sprintf(
"%.2f",
ft1["severity_num", "Std. Error"]
),
"", "", "", "", "", "", ""
),
p = c(
fmt_p(
ft1["(Intercept)", "Pr(>|t|)"]
),
fmt_p(
ft1["severity_num", "Pr(>|t|)"]
),
"", "", "", "", "", "", ""
),
stringsAsFactors = FALSE
)
# ─────────────────────────────────────────────────────────────
# Print Table 10
# ─────────────────────────────────────────────────────────────
trueness_df %>%
kable(
caption =
"Table 10. MLM Results for Perceived Trueness of Finding",
col.names = c(
"Parameter",
"b",
"SE",
"p"
),
align = c(
"l",
"r",
"r",
"r"
),
escape = FALSE
) %>%
kable_styling(
full_width = FALSE,
font_size = 11,
bootstrap_options =
c(
"condensed",
"bordered"
)
) %>%
footnote(
general =
"Trueness was centered at 3 (neutral). QRP Severity was effect coded as minor = −1, moderate = 0, and major = 1. * p < .05. ** p < .01. *** p < .001.",
general_title =
"Note.",
footnote_as_chunk =
TRUE
)
cat("\n--- Integrity random effects ---\n")
print(get_variance_components(T4))
print(get_random_intercept_icc(T4))
cat("\n--- Likeability random effects ---\n")
print(get_variance_components(L4))
print(get_random_intercept_icc(L4))
cat("\n--- Trueness random effects ---\n")
print(get_variance_components(FT1))
print(get_random_intercept_icc(FT1))
emm_true_df = as.data.frame(
emmeans(
FT1,
~ severity_num,
at = list(severity_num = c(-1, 0, 1))
)
) %>%
mutate(
Severity = factor(
severity_num,
levels = c(-1, 0, 1),
labels = c("Minor", "Moderate", "Major")
)
)
ggplot(
emm_true_df,
aes(
x = Severity,
y = emmean,
group = 1
)
) +
geom_line(linewidth = 2, color = "#7B1FA2") +
geom_point(size = 5, color = "#7B1FA2") +
geom_errorbar(
aes(ymin = lower.CL, ymax = upper.CL),
width = 0.20,
color = "#7B1FA2"
) +
labs(
title = "Perceived Trueness of Finding by QRP Severity",
y = "Trueness (Estimated Marginal Mean)",
x = "QRP Severity"
) +
theme_minimal(base_size = 15) +
coord_cartesian(ylim = c(-3, 3))
