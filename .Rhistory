)
# ─────────────────────────────────────────────────────────────
# TABLE 10: PERCEIVED TRUENESS OF FINDING
# ─────────────────────────────────────────────────────────────
# Fixed effects
ft1 <- summary(FT1)$coefficients
# Random effects
ft1_vc <- as.data.frame(
lme4::VarCorr(FT1)
)
# Extract variance components
participant_var <- ft1_vc$vcov[
ft1_vc$grp == "responseid"
]
vignette_var <- ft1_vc$vcov[
ft1_vc$grp == "severity"
]
residual_var <- ft1_vc$vcov[
ft1_vc$grp == "Residual"
]
# Total variance
total_var <-
participant_var +
vignette_var +
residual_var
# ICCs
participant_icc <-
participant_var / total_var
vignette_icc <-
vignette_var / total_var
# ─────────────────────────────────────────────────────────────
# Create table
# ─────────────────────────────────────────────────────────────
trueness_df <- data.frame(
Parameter = c(
"Intercept",
"QRP Severity",
"Participant variance",
"Vignette variance",
"Residual variance",
"ICC: Participant",
"ICC: Vignette",
"AIC",
"BIC"
),
b = c(
sprintf(
"%.2f",
ft1["(Intercept)", "Estimate"]
),
sprintf(
"%.2f",
ft1["severity_num", "Estimate"]
),
sprintf(
"%.3f",
participant_var
),
sprintf(
"%.3f",
vignette_var
),
sprintf(
"%.3f",
residual_var
),
sprintf(
"%.3f",
participant_icc
),
sprintf(
"%.3f",
vignette_icc
),
sprintf(
"%.1f",
AIC(FT1)
),
sprintf(
"%.1f",
BIC(FT1)
)
),
SE = c(
sprintf(
"%.2f",
ft1["(Intercept)", "Std. Error"]
),
sprintf(
"%.2f",
ft1["severity_num", "Std. Error"]
),
"", "", "", "", "", "", ""
),
p = c(
fmt_p(
ft1["(Intercept)", "Pr(>|t|)"]
),
fmt_p(
ft1["severity_num", "Pr(>|t|)"]
),
"", "", "", "", "", "", ""
),
stringsAsFactors = FALSE
)
# ─────────────────────────────────────────────────────────────
# Print Table 10
# ─────────────────────────────────────────────────────────────
trueness_df %>%
kable(
caption =
"Table 10. MLM Results for Perceived Trueness of Finding",
col.names = c(
"Parameter",
"b",
"SE",
"p"
),
align = c(
"l",
"r",
"r",
"r"
),
escape = FALSE
) %>%
kable_styling(
full_width = FALSE,
font_size = 11,
bootstrap_options =
c(
"condensed",
"bordered"
)
) %>%
footnote(
general =
"Trueness was centered at 3 (neutral). QRP Severity was effect coded as minor = −1, moderate = 0, and major = 1. * p < .05. ** p < .01. *** p < .001.",
general_title =
"Note.",
footnote_as_chunk =
TRUE
)
