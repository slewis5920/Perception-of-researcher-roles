# install packages if needed
if (!requireNamespace("pwr", quietly = TRUE)) install.packages("pwr")
if (!requireNamespace("sjstats", quietly = TRUE)) install.packages("sjstats")
library(pwr)      # pwr.f2.test
library(sjstats)  # design_effect
library(dplyr)
library(tibble)
library(purrr)
library(tidyverse)
library(janitor)
library(here)
library(psych)
library(car)
library(effectsize)
library(broom)
library(knitr)
library(kableExtra)
library(stringr)
library(here)
data_path =  here::here("Diss_Subset.csv")
diss.pilot =  read.csv(data_path)
#make all the columns lowercase to help with coding
names(diss.pilot) = tolower(names(diss.pilot))
#time to make this words into numbers :)
diss.pilot = diss.pilot %>%
mutate(consent.form. = case_when(
consent.form. == "Yes, I consent" ~ 1,
consent.form. == "No, I will leave the survey now" ~ 0,
TRUE ~ NA_real_
))
diss.pilot = diss.pilot %>%
mutate(across(
matches("(hon|sin|eth|like|app|con)$") & where(is.character),
~ as.numeric(str_extract(.x, "^\\d+"))
))
#this makes the new score dataset
Diss.subsetscoring = diss.pilot%>%
select(consent.form.,
khon, ksin, keth, klike, kapp, kcon,
shon, ssin, seth, slike, sapp,
minsmart, minbetter, mincreative, minrather,
minshould, minregard, mintyp, minkeep, minget,
Hhon, Hsin, heth,
hhon, hsin, heth, hlike, happ, hcon,
fhon, fsin, feth, flike, fapp,
modsmart, modbett, modcreat, modrath,
modshou, modreg, modtyp, modkeep, modget,
xhon, xsin, xeth, xlike, xapp, xcon,
yhon, ysin, yeth, ylike, yapp,
majsmart, majbet, majcreat, majrath,
majshould, majreg, majtyp, majkeep, majget,
attention1,
ethnic, race, race.other, gender.identity,
q78, education, political, sex.orientation,
q92, old, religion, religion.other,
id)
#this makes the new score dataset
