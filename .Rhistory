library(pwr)      # pwr.f2.test
library(sjstats)  # design_effect
library(dplyr)
library(tibble)
library(purrr)
library(tidyverse)
library(janitor)
library(here)
library(psych)
library(car)
library(effectsize)
library(broom)
library(knitr)
library(kableExtra)
library(stringr)
library(here)
data_path =  here::here("Diss_Subset.csv")
diss.pilot =  read.csv(data_path)
#make all the columns lowercase to help with coding
names(diss.pilot) = tolower(names(diss.pilot))
#time to make this words into numbers :)
diss.pilot = diss.pilot %>%
mutate(consent.form. = case_when(
consent.form. == "Yes, I consent" ~ 1,
consent.form. == "No, I will leave the survey now" ~ 0,
TRUE ~ NA_real_
))
diss.pilot = diss.pilot %>%
mutate(across(
matches("(hon|sin|eth|like|app|con)$") & where(is.character),
~ as.numeric(str_extract(.x, "^\\d+"))
))
#this makes the new score dataset
Diss.subsetscoring = diss.pilot%>%
select(consent.form.,
khon, ksin, keth, klike, kapp, kcon,
shon, ssin, seth, slike, sapp,
minsmart, minbetter, mincreative, minrather,
minshould, minregard, mintyp, minkeep, minget,
hhon, hsin, heth,
hhon, hsin, heth, hlike, happ, hcon,
fhon, fsin, feth, flike, fapp,
modsmart, modbett, modcreat, modrath,
modshou, modreg, modtyp, modkeep, modget,
xhon, xsin, xeth, xlike, xapp, xcon,
yhon, ysin, yeth, ylike, yapp,
majsmart, majbet, majcreat, majrath,
majshould, majreg, majtyp, majkeep, majget,
attention1,
ethnic, race, race.other, gender.identity,
q78, education, political, sex.orientation,
q92, old, religion, religion.other,
id)
# Initial data count to see what in the data set
initial_count = nrow(Diss.subsetscoring)
print(initial_count)
# Filter by consent
filtered_by_consent = Diss.subsetscoring %>%
filter(consent.form. == 1)
count_by_consent = nrow(filtered_by_consent)
#gets a table for age and prints unique answers
Diss.subsetscoring$age = as.numeric(Diss.subsetscoring$old)
unique_age = unique(Diss.subsetscoring$old)
print(unique_age)
mean_age = mean(Diss.subsetscoring$old, na.rm = TRUE)
print(mean_age)
#gets a table participants that consent for all participants before exclusions
consent_table.OG = table(diss.pilot$consent.form.)
print(consent_table.OG)
#gets a table participants that consent in the score dataset
consent_table = table(Diss.subsetscoring$consent.form.)
print(consent_table)
#gets a table for each demo questions
gender_table = table(Diss.subsetscoring$gender.identity)
ethnicity_table = table(Diss.subsetscoring$ethnic)
SO_table = table(Diss.subsetscoring$sex.orientation)
Race_table = table(Diss.subsetscoring$race)
politcal_table = table(Diss.subsetscoring$political)
religion_table = table(Diss.subsetscoring$religion)
education_table = table(Diss.subsetscoring$education)
#prints results for each demo questions
print(gender_table)
print(ethnicity_table)
print(SO_table)
print(Race_table)
print(politcal_table)
print(religion_table)
print(education_table)
#shows all unique answers to the "other" options for each demo the prints them
unique_rel= unique(Diss.subsetscoring$religion.other)
print(unique_rel)
#shows all unique answers to the "other" options for each demo the prints them
unique_race = unique(Diss.subsetscoring$race.other)
print(unique_race)
#shows all unique answers to the "other" options for each demo the prints them
unique_sexual_orientation = unique(Diss.subsetscoring$q92)
print(unique_sexual_orientation)
#shows all unique answers to the "other" options for each demo the prints them
unique_gender = unique(Diss.subsetscoring$q78)
print(unique_gender)
