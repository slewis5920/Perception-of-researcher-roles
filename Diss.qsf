ID103","SecondaryAttribute":"Which researcher do you think is more highly regarded in their field?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which researcher do you think is more highly regarded in their field?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which researcher do you think is more highly regarded in their field?","Choices":{"1":{"Display":"reported researcher (X)"},"2":{"Display":"neither reported (X) nor reporting researcher (Y)"},"3":{"Display":"reporting researcher (Y)"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Which researcher do you think is more highly regarded in their field?","DataExportTag":"majreg","QuestionID":"QID103"}},{"SurveyID":"SV_d0XMwEApRDPv1mC","Element":"SQ","PrimaryAttribute":"QID104","SecondaryAttribute":"Which researcher is more like the typical researcher?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which researcher is more like the typical researcher?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which researcher is more like the typical researcher?","Choices":{"1":{"Display":"reported researcher (X)"},"2":{"Display":"neither reported (X) nor reporting researcher (Y)"},"3":{"Display":"reporting researcher (Y)"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Which researcher is more like the typical researcher?","DataExportTag":"majtyp","QuestionID":"QID104"}},{"SurveyID":"SV_d0XMwEApRDPv1mC","Element":"SQ","PrimaryAttribute":"QID105","SecondaryAttribute":"Which researcher is more likely to keep a job?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which researcher is more likely to keep a job?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which researcher is more likely to keep a job?","Choices":{"1":{"Display":"reported researcher (X)"},"2":{"Display":"neither reported (X) nor reporting researcher (Y)"},"3":{"Display":"reporting researcher (Y)"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Which researcher is more likely to keep a job?","DataExportTag":"majkeep","QuestionID":"QID105"}},{"SurveyID":"SV_d0XMwEApRDPv1mC","Element":"SQ","PrimaryAttribute":"QID106","SecondaryAttribute":"Which researcher is more likely to get a job?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which researcher is more likely to get a job?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which researcher is more likely to get a job?","Choices":{"1":{"Display":"reported researcher (X)"},"2":{"Display":"neither reported (X) nor reporting researcher (Y)"},"3":{"Display":"reporting researcher (Y)"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Which researcher is more likely to get a job?","DataExportTag":"majget","QuestionID":"QID106"}},{"SurveyID":"SV_d0XMwEApRDPv1mC","Element":"SQ","PrimaryAttribute":"QID107","SecondaryAttribute":"The following questions will ask you to consider specific attributes and select the researcher wh...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: left;\"><strong><span style=\"font-size: 16px; font-family: Arial, Helvetica, sans-serif;\">The following questions will ask you to consider specific attributes and select the researcher who best fits each one.<\/span><\/strong><br>\n&nbsp;<\/div>\n<span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"font-size:16px;\"><strong>For reference, below is the information provided about the researchers:<\/strong><br>\n<br>\nResearcher H conducted a study and found an interesting result. After publication, Researcher H\u2019s data and materials were made available to the public. While looking through the open data, it was discovered that Researcher H had played around with excluding certain data points until they achieved a significant result to be able to publish.<br>\n<br>\nAfter examining the dataset, Researcher F writes a blog post presenting evidence on how Researcher H manipulated their data to achieve statistically significant results. Researcher F emphasizes that this practice misleads the scientific community and undermines the credibility of science.&nbsp;<\/span><\/span><br>\n&nbsp;","DefaultChoices":false,"DataExportTag":"Attrinst","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The following questions will ask you to consider specific attributes and select the researcher wh...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID107"}},{"SurveyID":"SV_d0XMwEApRDPv1mC","Element":"SQ","PrimaryAttribute":"QID108","SecondaryAttribute":"The following questions will ask you to consider specific attributes and select the researcher wh...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p data-end=\"219\" data-start=\"101\"><strong><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"font-size:16px;\">The following questions will ask you to consider specific attributes and select the researcher who best fits each one.<\/span><\/span><\/strong><br \/>\n&nbsp;<\/p>\n\n<p data-end=\"292\" data-start=\"221\"><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"font-size:16px;\"><strong>For reference, below is the information provided about the researchers:<\/strong><\/span><\/span><br \/>\n&nbsp;<\/p>\n<span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"font-size:16px;\">Researcher K conducted a study and found an interesting result. Researcher K&rsquo;s project paper was published and made available to the public. Researcher K submitted the findings to a journal for publication, but the abstract implied the study had much broader implications than the study truly did.&nbsp;<br \/>\n<br \/>\nResearcher S after reading the abstract, writes a blog post highlighting how Researcher K&rsquo;s misrepresentations can mislead readers about the scope and findings of the research. Researcher S emphasizes the importance of crafting precise titles and abstracts to ensure that research is accurately represented and understood, warning that misleading summaries can undermine the credibility of science.<\/span><\/span>","DefaultChoices":false,"DataExportTag":"minattri","QuestionID":"QID108","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The following questions will ask you to consider specific attributes and select the researcher wh...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_d0XMwEApRDPv1mC","Element":"SQ","PrimaryAttribute":"QID109","SecondaryAttribute":"The following questions will ask you to consider specific attributes and select the researcher wh...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"font-size:16px;\"><strong>The following questions will ask you to consider specific attributes and select the researcher who best fits each one.<br><\/strong><br>\n<strong>For reference, below is the information provided about the researchers:<\/strong><br>\n<br>\nResearcher X conducted a study and found an interesting result. After publication, Researcher X\u2019s data and materials were made available to the public. While looking through the open data, it was discovered that Researcher X had fabricated or made up large sections of the dataset.<br>\n<br>\nAfter examining the dataset, Researcher Y writes a blog post highlighting which data points Researcher X fabricated. Researcher Y suggests the fabrication is a prime example of how such misconduct not only has devastating consequences on scientific integrity but can also lead to severe career repercussions for collaborators.<\/span><\/span>","DefaultChoices":false,"DataExportTag":"MajAtt","QuestionID":"QID109","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The following questions will ask you to consider specific attributes and select the researcher wh...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_d0XMwEApRDPv1mC","Element":"SQ","PrimaryAttribute":"QID11","SecondaryAttribute":"How sincere or insincere is Researcher K?","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\">How sincere or insincere is <b>Researcher K<\/b>?<\/span>","DataExportTag":"Ksin","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How sincere or insincere is Researcher K?","Choices":{"1":{"Display":"1 = very insincere"},"2":{"Display":"2 = somewhat insincere"},"3":{"Display":"3 = neither sincere nor insincere"},"4":{"Display":"4 = somewhat sincere"},"5":{"Display":"5 = very sincere"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID11"}},{"SurveyID":"SV_d0XMwEApRDPv1mC","Element":"SQ","PrimaryAttribute":"QID110","SecondaryAttribute":"Have a great day!\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><span style=\"font-family:Comic Sans MS,cursive;\"><span style=\"font-size:29px;\"><strong>Have a great day!&nbsp;<\/strong><\/span><\/span><\/div>","DefaultChoices":false,"DataExportTag":"noconsent","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Have a great day!\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID110"}},{"SurveyID":"SV_d0XMwEApRDPv1mC","Element":"SQ","PrimaryAttribute":"QID112","SecondaryAttribute":"If other, please describe.","TertiaryAttribute":null,"Payload":{"QuestionText":"If other, please describe.","DefaultChoices":false,"DataExportTag":"Q92","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If other, please describe.","DisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID76\/SelectableChoice\/5","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Which of the following best describes your sexual orientation?<\/span> <span class=\"LeftOpDesc\">Other<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID76\/SelectableChoice\/5","LogicType":"Question","Operator":"Selected","QuestionID":"QID76","QuestionIDFr